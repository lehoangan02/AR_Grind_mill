  m_Name: MrSix_AboutTheMill
  m_EditorClassIdentifier: Assembly-CSharp::AR_Grind_mill.Dialogue.Data.DialogueNode
  editorNotes: 
  line:
    speakerName: Mr. Six
    text: This old stone mill has been turning grain for three generations. My grandfather
      laid these stones before the French came, and the river still turns the wheel
      as faithfully as it did on his first morning.
    animationTag: 
    voiceClip: {fileID: 0}
    autoAdvanceAfter: 0
  choices:
  - choiceText: What rice do you mill?
